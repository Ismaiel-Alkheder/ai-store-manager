# Production environment template
# Copy these names into your hosting provider's Environment Variables.
# Do NOT commit real secrets to Git.

# Shopify store handle only, for example: my-store
SHOPIFY_SHOP=

# Shopify app credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Public HTTPS origin used by the admin UI security checks.
# Example: https://store-manager.example.com
ADMIN_PUBLIC_ORIGIN=

# Public HTTPS base URL Shopify uses for webhook callbacks.
# This may be the same domain as ADMIN_PUBLIC_ORIGIN.
# Example: https://store-manager.example.com
WEBHOOK_BASE_URL=

# Bootstrap password hash for a fresh production database.
# Keep the real value secret.
ADMIN_PASSWORD_HASH=

# Long random secret used to sign admin sessions.
# Use at least 32 characters and keep it secret.
ADMIN_SESSION_SECRET=

# Optional for now.
# Leave unset until OpenAI billing/API use is intentionally enabled.
# OPENAI_API_KEY=
